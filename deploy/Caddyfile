{
	# Set SITE_ADDRESS=your.domain.com in .env for automatic HTTPS. Defaults to plain HTTP on :80.
	admin off
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
	}
}
