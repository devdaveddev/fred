# Copy to .env and change the password before deploying anywhere public.
POSTGRES_USER=fred
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fred

# Accounts: set COOKIE_SECURE=true whenever the site is served over HTTPS (SITE_ADDRESS is a domain).
COOKIE_SECURE=false
ALLOW_SIGNUP=true
# Encrypts Stripe/HubSpot credentials at rest. Generate: openssl rand -base64 32. Keep it stable.
FRED_SECRET_KEY=change-me-to-a-long-random-string

# Notifications. Links in Slack/email point at PUBLIC_URL. Email is off until SMTP_HOST is set
# (any provider: Postmark, SES, SendGrid, Mailgun, Google Workspace). SMTP_TLS: starttls | ssl | none.
PUBLIC_URL=http://localhost:8080
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Fred <fred@yourdomain.com>
SMTP_TLS=starttls

# Direct connections. Register an app with each provider and set its redirect URI to
#   ${PUBLIC_URL}/api/sources/oauth/callback        (SSO uses ${PUBLIC_URL}/api/auth/sso/callback)
# Sources without an app still work through CSV upload. Stripe, HubSpot, Meta Ads, Zendesk and Intercom
# use keys the customer pastes in, so they need nothing here.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_SANDBOX=false
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
GUSTO_CLIENT_ID=
GUSTO_CLIENT_SECRET=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=

# The crew (role agents). With a key, CrewAI agents write follow-up and reminder emails with Claude;
# without one they use plain templates. Numbers are always Fred's; untraceable numbers are blocked.
ANTHROPIC_API_KEY=
AGENT_LLM=anthropic/claude-sonnet-5-5

# Public entrypoint. Set SITE_ADDRESS=app.example.com for automatic HTTPS via Caddy.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

TAG=latest
LOG_LEVEL=info
